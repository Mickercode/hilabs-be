# Copy to .env and fill in. .env is gitignored; this repo is public, so never commit real values.

# PostgreSQL 16. The schema in db/schema.sql must be applied before the API will start.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hilabs

NODE_ENV=development
PORT=3000

# Where the learner app is served from, for CORS.
WEB_ORIGIN=http://localhost:3001

# The AI companion. Leave blank until the companion module exists; the API runs without it.
ANTHROPIC_API_KEY=
