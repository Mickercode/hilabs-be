# Copy to .env and fill in. .env is gitignored; this repo is public, so never commit real values.

# PostgreSQL 16. Apply db/schema.sql before starting the API: `npm run db:reset`.
#
# Use 127.0.0.1 rather than localhost. On Windows with Docker Desktop, localhost resolves to the
# IPv6 ::1 first and the connection times out against a container published on IPv4.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/hilabs

NODE_ENV=development
PORT=3000

# Where the learner app is served from, for CORS.
WEB_ORIGIN=http://localhost:3001

# The AI companion. Leave blank until the companion module calls a model; the API runs without it.
ANTHROPIC_API_KEY=
